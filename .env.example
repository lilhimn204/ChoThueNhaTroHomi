# Copy to .env for local Docker/development.

GOOGLE_CLIENT_ID=

APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@homi.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=true

# Required by docker-compose.yml. Use a unique strong value per environment.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Local HTTP Docker should stay false. Production HTTPS should override to true.
AUTH_COOKIE_SECURE=false
